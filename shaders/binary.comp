#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer InputA  { float a[]; };
layout(set = 0, binding = 1) buffer InputB  { float b[]; };
layout(set = 0, binding = 2) buffer OutputC { float c[]; };

layout(push_constant) uniform PushConsts {
    float n_elements;
    float op;
    float padding;
} pc;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint n   = uint(pc.n_elements);
    uint op  = uint(pc.op);

    if (idx >= n) return;

    float result;
    if (op == 0u) {
        result = a[idx] + b[idx];
    } else if (op == 1u) {
        result = a[idx] - b[idx];
    } else if (op == 2u) {
        result = a[idx] * b[idx];
    } else {
        result = a[idx] / b[idx];
    }

    c[idx] = result;
}
