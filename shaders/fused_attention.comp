#version 450

// Fused multi-head attention: computes all heads in one kernel dispatch.
// Q, K, V are (B, d_model) = (B, n_heads * d_k).
// Each workgroup handles one head for one query position.
// Output: attn_out(B, d_model) — concatenated per-head outputs.
// NOTE: Experimental — not currently used in training (individual ops used instead).

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer Qbuf { float Q[]; };     // (B, d_model)
layout(set = 0, binding = 1) buffer Kbuf { float K[]; };     // (B, d_model)
layout(set = 0, binding = 2) buffer Vbuf { float V[]; };     // (B, d_model)
layout(set = 0, binding = 3) buffer Obuf { float O[]; };     // output (B, d_model)

layout(push_constant) uniform Push {
    float B;        // batch * seq_len
    float d_model;  // total dimension
    float n_heads;
    float d_k;
} pc;

shared float s_score[32];   // shared memory for score computation

void main() {
    uint Bval     = uint(pc.B);
    uint dmodel   = uint(pc.d_model);
    uint nheads   = uint(pc.n_heads);
    uint dk       = uint(pc.d_k);
    uint head     = gl_WorkGroupID.x;         // which head
    uint pos      = gl_WorkGroupID.y;         // which output position
    uint lid      = gl_LocalInvocationID.x;   // thread in workgroup (0..dk-1)

    if (head >= nheads || pos >= Bval) return;

    uint hs = head * dk;  // start index for this head in the flat d_model

    // Step 1: compute score = Q[pos, head*dk:(head+1)*dk] @ K[pos2, head*dk:(head+1)*dk]
    // One workgroup per (head, pos), so we compute all attention over all pos2
    // and accumulate in shared memory.

    // We'll iterate over all other positions (pos2) to compute the full softmax
    float max_val = -1e20;
    float sum_exp = 0.0;

    // First pass: compute max for numerical stability
    for (uint pos2 = 0; pos2 < Bval; pos2++) {
        float score = 0.0;
        for (uint k = lid; k < dk; k += 32u) {
            score += Q[pos * dmodel + hs + k] * K[pos2 * dmodel + hs + k];
        }
        s_score[lid] = score;
        // Sum within workgroup
        barrier();
        for (uint s = 16u; s > 0u; s >>= 1) {
            if (lid < s) { s_score[lid] += s_score[lid + s]; }
            barrier();
        }
        if (lid == 0u) {
            score = s_score[0] / sqrt(float(dk));
            if (score > max_val) max_val = score;
        }
        barrier();
    }

    // Second pass: compute sum of exp(score - max)
    for (uint pos2 = 0; pos2 < Bval; pos2++) {
        float score = 0.0;
        for (uint k = lid; k < dk; k += 32u) {
            score += Q[pos * dmodel + hs + k] * K[pos2 * dmodel + hs + k];
        }
        s_score[lid] = score;
        barrier();
        for (uint s = 16u; s > 0u; s >>= 1) {
            if (lid < s) { s_score[lid] += s_score[lid + s]; }
            barrier();
        }
        if (lid == 0u) {
            score = s_score[0] / sqrt(float(dk));
            sum_exp += exp(score - max_val);
        }
        barrier();
    }

    // Third pass: weighted sum of V
    float result = 0.0;
    for (uint pos2 = 0; pos2 < Bval; pos2++) {
        float score = 0.0;
        for (uint k = lid; k < dk; k += 32u) {
            score += Q[pos * dmodel + hs + k] * K[pos2 * dmodel + hs + k];
        }
        s_score[lid] = score;
        barrier();
        for (uint s = 16u; s > 0u; s >>= 1) {
            if (lid < s) { s_score[lid] += s_score[lid + s]; }
            barrier();
        }
        if (lid == 0u) {
            score = s_score[0] / sqrt(float(dk));
            float weight = exp(score - max_val) / sum_exp;
            // Each thread writes its d_k element
            for (uint k = 0u; k < dk; k++) {
                // We need to compute the weighted sum for each output element
                // This requires a third nested loop. For simplicity, each thread
                // handles one output element (k = lid) across all positions.
            }
        }
        barrier();
    }

    // Write output element for this position and head
    if (lid < dk) {
        O[pos * dmodel + hs + lid] = result;
    }
}